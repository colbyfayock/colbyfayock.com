    "fuse.js": "^7.1.0",
    "he": "^1.2.0",
    "loader-utils": "^3.3.1",
    "next": "^16.1.6",
    "next-plausible": "^3.12.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "rss": "^1.2.2",
    "sass": "^1.92.1"
